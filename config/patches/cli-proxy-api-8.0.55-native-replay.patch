+package executor
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+)
+
+func copySeekableBytes(ctx context.Context, target io.Writer, source io.Reader, limit int64) (int64, error) {
+	buffer := make([]byte, 64*1024)
+	var copied int64
+	for limit < 0 || copied < limit {
+		if err := ctx.Err(); err != nil {
+			return copied, err
+		}
+		part := buffer
+		if limit >= 0 && int64(len(part)) > limit-copied {
+			part = part[:limit-copied]
+		}
+		read, err := source.Read(part)
+		if read > 0 {
+			written, writeErr := target.Write(part[:read])
+			copied += int64(written)
+			if writeErr != nil {
+				return copied, writeErr
+			}
+			if written != read {
+				return copied, io.ErrShortWrite
+			}
+		}
+		if err == io.EOF && limit < 0 {
+			return copied, nil
+		}
+		if err != nil {
+			return copied, err
+		}
+	}
+	return copied, nil
+}
+
+// WriteSeekableModel rewrites only the verified top-level model string while
+// copying every other byte, including opaque history and image data, verbatim.
+func WriteSeekableModel(ctx context.Context, body SeekableBody, start, end int64, model string, output io.Writer) (int64, error) {
+	if body == nil || start < 0 || end <= start || end > body.Size() {
+		return 0, errors.New("seekable model span is invalid")
+	}
+	encoded, err := json.Marshal(model)
+	if err != nil {
+		return 0, err
+	}
+	reader, err := body.Open()
+	if err != nil {
+		return 0, err
+	}
+	defer reader.Close()
+	if err = ctx.Err(); err != nil {
+		return 0, err
+	}
+	first, err := copySeekableBytes(ctx, output, reader, start)
+	if err != nil {
+		return first, err
+	}
+	if _, err = copySeekableBytes(ctx, io.Discard, reader, end-start); err != nil {
+		return first, err
+	}
+	second, err := output.Write(encoded)
+	total := first + int64(second)
+	if err != nil {
+		return total, err
+	}
+	if second != len(encoded) {
+		return total, io.ErrShortWrite
+	}
+	if err = ctx.Err(); err != nil {
+		return total, err
+	}
+	last, err := copySeekableBytes(ctx, output, reader, -1)
+	return total + last, err
+}
+
+// NewSeekableModelBody opens one replay attempt with bounded pipe backpressure.
+func NewSeekableModelBody(ctx context.Context, body SeekableBody, start, end int64, model string) (io.ReadCloser, int64, error) {
+	if body == nil || start < 0 || end <= start || end > body.Size() {
+		return nil, 0, errors.New("seekable model span is invalid")
+	}
+	encoded, err := json.Marshal(model)
+	if err != nil {
+		return nil, 0, err
+	}
+	pipeReader, pipeWriter := io.Pipe()
+	go func() {
+		_, copyErr := WriteSeekableModel(ctx, body, start, end, model, pipeWriter)
+		_ = pipeWriter.CloseWithError(copyErr)
+	}()
+	return pipeReader, body.Size() - (end - start) + int64(len(encoded)), nil
+}
