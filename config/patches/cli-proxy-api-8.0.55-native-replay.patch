+package executor
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"runtime"
+	"sync"
+	"sync/atomic"
+)
+
+// SeekableBody is a request-scoped, replayable body owned by the execution host.
+// Each Open starts at byte zero; Close releases private storage after all attempts end.
+type SeekableBody interface {
+	Open() (io.ReadCloser, error)
+	Size() int64
+	ReadJSONStringRange(start, end int64) (string, error)
+	CopySpan(ctx context.Context, output io.Writer, start, end int64) (int64, error)
+	Close() error
+}
+
+const seekableChunkBytes = 64 * 1024
+
+type seekableProviderTerminalKey struct{}
+type seekableProviderAttemptKey struct{}
+
+type SeekableProviderTerminalProof struct {
+	current  atomic.Uint64
+	complete atomic.Uint64
+}
+
+func WithSeekableProviderTerminalProof(ctx context.Context) (context.Context, *SeekableProviderTerminalProof) {
+	proof := &SeekableProviderTerminalProof{}
+	return context.WithValue(ctx, seekableProviderTerminalKey{}, proof), proof
+}
+
+func InheritSeekableProviderTerminalProof(parent, request context.Context) context.Context {
+	if proof, ok := request.Value(seekableProviderTerminalKey{}).(*SeekableProviderTerminalProof); ok {
+		return context.WithValue(parent, seekableProviderTerminalKey{}, proof)
+	}
+	return parent
+}
+
+func BeginSeekableProviderAttempt(ctx context.Context) context.Context {
+	if proof, ok := ctx.Value(seekableProviderTerminalKey{}).(*SeekableProviderTerminalProof); ok {
+		return context.WithValue(ctx, seekableProviderAttemptKey{}, proof.current.Add(1))
+	}
+	return ctx
+}
+
+func MarkSeekableProviderTerminalProof(ctx context.Context) {
+	proof, hasProof := ctx.Value(seekableProviderTerminalKey{}).(*SeekableProviderTerminalProof)
+	attempt, hasAttempt := ctx.Value(seekableProviderAttemptKey{}).(uint64)
+	if hasProof && hasAttempt && attempt != 0 && ctx.Err() == nil && proof.current.Load() == attempt {
+		proof.complete.Store(attempt)
+	}
+}
+
+func (p *SeekableProviderTerminalProof) Complete() bool {
+	return p != nil && p.current.Load() != 0 && p.complete.Load() == p.current.Load()
+}
+
+var ErrSeekableDiskPressure = errors.New("private replay storage has less than the host free-space reserve")
+
+// SeekableBodyBudget admits native streams by disk availability, not request count.
+// A reserve is charged before each write, including room for one transformed copy.
+type SeekableBodyBudget struct {
+	mu       sync.Mutex
+	capacity int64
+	reserved int64
+	active   int
+	large    int
+}
+
+func NewSeekableBodyBudget(capacity int64) (*SeekableBodyBudget, error) {
+	if capacity != 0 && capacity < 256<<20 {
+		return nil, errors.New("seekable body needs physical disk admission or a finite byte budget")
+	}
+	return &SeekableBodyBudget{capacity: capacity}, nil
+}
+
+func (b *SeekableBodyBudget) reserve(body *privateSeekableBody, next int64) error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	becomesLarge := !body.large && body.size+next > 16<<20
+	ceiling := b.capacity
+	if body.large || becomesLarge {
+		ceiling -= 64 << 20
+	}
+	if next <= 0 || (b.capacity != 0 && next > (ceiling-b.reserved)/2) {
+		return errors.New("seekable body aggregate disk budget is busy")
+	}
+	if becomesLarge {
+		body.large = true
+		b.large++
+	}
+	if b.capacity == 0 {
+		if err := assertSeekableDiskFree(os.TempDir(), 2*next); err != nil {
+			return err
+		}
+	}
+	b.reserved += 2 * next
+	return nil
+}
+
+func (b *SeekableBodyBudget) release(body *privateSeekableBody) {
+	b.mu.Lock()
+	b.reserved -= 2 * body.size
+	b.active--
+	if body.large {
+		b.large--
+	}
+	b.mu.Unlock()
+}
+
+func (b *SeekableBodyBudget) Snapshot() (active int, reserved int64) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.active, b.reserved
+}
+
+// IngestSeekableBody retains bytes on a private unlinked file. A process crash
+// closes the only descriptor, so request data cannot survive as an orphan file.
+func (b *SeekableBodyBudget) IngestSeekableBody(ctx context.Context, source io.Reader, expectedSHA256 string) (SeekableBody, error) {
+	if len(expectedSHA256) != sha256.Size*2 {
+		return nil, errors.New("seekable body digest is missing")
+	}
+	return b.ingest(ctx, source, expectedSHA256)
+}
+
+func (b *SeekableBodyBudget) IngestSeekableResponse(ctx context.Context, source io.Reader) (SeekableBody, error) {
+	return b.ingest(ctx, source, "")
+}
+
+func (b *SeekableBodyBudget) ingest(ctx context.Context, source io.Reader, expectedSHA256 string) (SeekableBody, error) {
+	if runtime.GOOS == "windows" {
+		return nil, errors.New("seekable body needs verified Windows owner-only ACLs")
+	}
+	b.mu.Lock()
+	b.active++
+	b.mu.Unlock()
+	body := &privateSeekableBody{budget: b}
+	defer func() {
+		if body.file == nil {
+			b.release(body)
+		}
+	}()
+	dir, err := os.MkdirTemp("", "cliproxy-native-replay-")
+	if err != nil {
+		return nil, err
+	}
+	file, err := os.CreateTemp(dir, "body-")
+	if err != nil {
+		_ = os.Remove(dir)
+		return nil, err
+	}
+	if err = os.Chmod(file.Name(), 0600); err == nil {
+		err = os.Remove(file.Name())
+	}
+	if err == nil {
+		err = os.Remove(dir)
+	}
+	if err != nil {
+		_ = file.Close()
+		_ = os.Remove(file.Name())
+		_ = os.Remove(dir)
+		return nil, err
+	}
+	body.file = file
+	digest := sha256.New()
+	chunk := make([]byte, seekableChunkBytes)
+	noProgress := 0
+	for {
+		if err = ctx.Err(); err != nil {
+			break
+		}
+		var count int
+		count, err = source.Read(chunk)
+		if count > 0 {
+			noProgress = 0
+			if reserveErr := b.reserve(body, int64(count)); reserveErr != nil {
+				err = reserveErr
+				break
+			}
+			body.size += int64(count)
+			if _, writeErr := file.Write(chunk[:count]); writeErr != nil {
+				err = writeErr
+				break
+			}
+			_, _ = digest.Write(chunk[:count])
+		} else if err == nil {
+			noProgress++
+			if noProgress >= 100 {
+				err = io.ErrNoProgress
+			}
+		}
+		if err != nil {
+			break
+		}
+	}
+	if err == io.EOF {
+		err = nil
+	}
+	if err == nil && expectedSHA256 != "" && hex.EncodeToString(digest.Sum(nil)) != expectedSHA256 {
+		err = errors.New("seekable body digest mismatch")
+	}
+	if err != nil {
+		_ = body.Close()
+		return nil, fmt.Errorf("seekable body admission: %w", err)
+	}
+	return body, nil
+}
+
+type privateSeekableBody struct {
+	mu     sync.Mutex
+	budget *SeekableBodyBudget
+	file   *os.File
+	size   int64
+	large  bool
+	closed bool
+}
+
+func (b *privateSeekableBody) Open() (io.ReadCloser, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || b.file == nil {
+		return nil, errors.New("seekable body is closed")
+	}
+	return io.NopCloser(io.NewSectionReader(b.file, 0, b.size)), nil
+}
+
+func (b *privateSeekableBody) Size() int64 { return b.size }
+
+func (b *privateSeekableBody) ReadJSONStringRange(start, end int64) (string, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || b.file == nil || start < 0 || end > b.size || end <= start || end-start > 4096 {
+		return "", errors.New("seekable model range is invalid")
+	}
+	raw := make([]byte, end-start)
+	if _, err := b.file.ReadAt(raw, start); err != nil {
+		return "", err
+	}
+	var actual string
+	if err := json.Unmarshal(raw, &actual); err != nil {
+		return "", errors.New("seekable model range is not a JSON string")
+	}
+	return actual, nil
+}
+
+func (b *privateSeekableBody) CopySpan(ctx context.Context, output io.Writer, start, end int64) (int64, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.closed || b.file == nil || start < 0 || end < start || end > b.size {
+		return 0, errors.New("seekable span is invalid")
+	}
+	return copySeekableBytes(ctx, output, io.NewSectionReader(b.file, start, end-start), end-start)
+}
+
+func (b *privateSeekableBody) Close() error {
+	b.mu.Lock()
+	if b.closed {
+		b.mu.Unlock()
+		return nil
+	}
+	b.closed = true
+	file := b.file
+	b.mu.Unlock()
+	var err error
+	if file != nil {
+		err = file.Close()
+	}
+	b.budget.release(b)
+	return err
+}
