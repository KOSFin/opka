+func TestSeekableCompactResponseRetainsOpaqueAndVisibleItems(t *testing.T) {
+	budget, err := cliproxyexecutor.NewSeekableBodyBudget(512 << 20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const before = `{"id":"synthetic","object":"response","output":[{"type":"compaction","encrypted_content":"`
+	const after = `"},{"type":"message","content":[{"type":"output_text","text":"retain this item"}]}],"usage":{"input_tokens":2,"output_tokens":1}}`
+	const largeBytes = 72 << 20
+	makeReader := func() io.Reader {
+		return io.MultiReader(strings.NewReader(before), io.LimitReader(repeatedSyntheticByte{}, largeBytes), strings.NewReader(after))
+	}
+	want := sha256.New()
+	if _, err = io.Copy(want, makeReader()); err != nil {
+		t.Fatal(err)
+	}
+	upstream, err := budget.IngestSeekableResponse(context.Background(), makeReader())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer upstream.Close()
+	shadow, err := cliproxyexecutor.BuildSeekableJSONShadow(context.Background(), upstream)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(shadow.Markers) != 1 || len(shadow.JSON) >= 1<<20 {
+		t.Fatalf("compact shadow bytes=%d markers=%d", len(shadow.JSON), len(shadow.Markers))
+	}
+	request := []byte(`{"model":"native","input":[]}`)
+	var param any
+	out := sdktranslator.TranslateNonStream(context.Background(), sdktranslator.FormatOpenAIResponse, sdktranslator.FormatOpenAIResponse, "native", request, request, shadow.JSON, &param)
+	if len(out) == 0 {
+		t.Fatal("compact translator discarded the response")
+	}
+	complete, err := reconstituteSeekableCodexResponse(context.Background(), budget, upstream, shadow, out)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer complete.Close()
+	stream, err := complete.Open()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stream.Close()
+	actual := sha256.New()
+	if _, err = io.Copy(actual, stream); err != nil {
+		t.Fatal(err)
+	}
+	if hex.EncodeToString(actual.Sum(nil)) != hex.EncodeToString(want.Sum(nil)) {
+		t.Fatal("compact output did not retain the complete canonical window")
+	}
+}
+
+func TestSeekableRequestPreservesOpaqueHistoryAfterHandlerMutation(t *testing.T) {
+	budget, err := cliproxyexecutor.NewSeekableBodyBudget(256 << 20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const before = `{"model":"native","input":[{"content":"`
+	const after = `"}],"metadata":{"user":"synthetic"}}`
+	reader := io.MultiReader(strings.NewReader(before), io.LimitReader(repeatedSyntheticByte{}, 20<<20), strings.NewReader(after))
+	body, err := budget.IngestSeekableResponse(context.Background(), reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer body.Close()
+	shadow, err := cliproxyexecutor.BuildSeekableJSONShadow(context.Background(), body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mutated := []byte(strings.Replace(string(shadow.JSON), `"synthetic"`, `"changed"`, 1))
+	req := cliproxyexecutor.Request{Payload: mutated, SeekablePayload: body}
+	opts := cliproxyexecutor.Options{
+		OriginalSeekableRequest: body,
+		SeekableShadowJSON:      shadow.JSON,
+		SeekableShadow:          shadow,
+		SourceFormat:            sdktranslator.FormatOpenAIResponse,
+	}
+	prepared, err := prepareSeekableCodexPayload(context.Background(), &req, &opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	httpRequest, err := http.NewRequest(http.MethodPost, "http://127.0.0.1/v1/responses", strings.NewReader("{}"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := attachSeekableCodexBody(context.Background(), body, prepared, mutated, httpRequest); err != nil {
+		t.Fatal(err)
+	}
+	defer httpRequest.Body.Close()
+	want := sha256.New()
+	_, _ = io.WriteString(want, before)
+	_, _ = io.Copy(want, io.LimitReader(repeatedSyntheticByte{}, 20<<20))
+	_, _ = io.WriteString(want, `"}],"metadata":{"user":"changed"}}`)
+	actual := sha256.New()
+	if _, err := io.Copy(actual, httpRequest.Body); err != nil {
+		t.Fatal(err)
+	}
+	if hex.EncodeToString(actual.Sum(nil)) != hex.EncodeToString(want.Sum(nil)) {
+		t.Fatal("request replay lost an opaque history item or bounded mutation")
+	}
+}
