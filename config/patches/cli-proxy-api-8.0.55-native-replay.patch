+package executor
+
+import (
+	"bytes"
+	"context"
+	"io"
+	"net/http"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+func prepareSeekableCodexPayload(ctx context.Context, req *cliproxyexecutor.Request, opts *cliproxyexecutor.Options) (cliproxyexecutor.SeekableJSONShadow, error) {
+	if req.SeekablePayload == nil || opts.OriginalSeekableRequest == nil ||
+		!bytes.Equal(opts.SeekableShadow.JSON, opts.SeekableShadowJSON) || opts.SourceFormat != sdktranslator.FormatOpenAIResponse {
+		return cliproxyexecutor.SeekableJSONShadow{}, statusErr{code: http.StatusUnprocessableEntity, msg: "seekable request changed before provider selection"}
+	}
+	shadow := opts.SeekableShadow
+	if _, err := cliproxyexecutor.WriteReconstitutedJSON(ctx, req.SeekablePayload, shadow, req.Payload, io.Discard); err != nil {
+		return shadow, statusErr{code: http.StatusUnprocessableEntity, msg: err.Error()}
+	}
+	return shadow, nil
+}
+
+func attachSeekableCodexBody(ctx context.Context, body cliproxyexecutor.SeekableBody, shadow cliproxyexecutor.SeekableJSONShadow, transformed []byte, request *http.Request) error {
+	if _, err := cliproxyexecutor.WriteReconstitutedJSON(ctx, body, shadow, transformed, io.Discard); err != nil {
+		return statusErr{code: http.StatusUnprocessableEntity, msg: err.Error()}
+	}
+	length, err := shadow.ReconstitutedLength(transformed)
+	if err != nil {
+		return statusErr{code: http.StatusUnprocessableEntity, msg: err.Error()}
+	}
+	open := func() (io.ReadCloser, error) {
+		reader, writer := io.Pipe()
+		go func() {
+			_, copyErr := cliproxyexecutor.WriteReconstitutedJSON(ctx, body, shadow, transformed, writer)
+			_ = writer.CloseWithError(copyErr)
+		}()
+		return reader, nil
+	}
+	_ = request.Body.Close()
+	request.Body, _ = open()
+	request.GetBody = open
+	request.ContentLength = length
+	request.Header.Del("Content-Encoding")
+	return nil
+}
+
+func reconstituteSeekableCodexResponse(ctx context.Context, budget *cliproxyexecutor.SeekableBodyBudget, source cliproxyexecutor.SeekableBody, shadow cliproxyexecutor.SeekableJSONShadow, transformed []byte) (cliproxyexecutor.SeekableBody, error) {
+	if budget == nil {
+		return nil, statusErr{code: http.StatusUnprocessableEntity, msg: "seekable response budget is missing"}
+	}
+	if _, err := cliproxyexecutor.WriteReconstitutedJSON(ctx, source, shadow, transformed, io.Discard); err != nil {
+		return nil, err
+	}
+	reader, writer := io.Pipe()
+	done := make(chan error, 1)
+	go func() {
+		_, err := cliproxyexecutor.WriteReconstitutedJSON(ctx, source, shadow, transformed, writer)
+		_ = writer.CloseWithError(err)
+		done <- err
+	}()
+	complete, ingestErr := budget.IngestSeekableResponse(ctx, reader)
+	_ = reader.CloseWithError(ingestErr)
+	writeErr := <-done
+	if ingestErr != nil {
+		return nil, ingestErr
+	}
+	if writeErr != nil {
+		_ = complete.Close()
+		return nil, writeErr
+	}
+	return complete, nil
+}
