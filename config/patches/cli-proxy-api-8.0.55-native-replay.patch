+package executor
+
+import (
+	"context"
+	"io"
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestSeekableHundredSimultaneousBodiesReleaseDisk(t *testing.T) {
+	directory := t.TempDir()
+	t.Setenv("TMPDIR", directory)
+	budget, err := NewSeekableBodyBudget(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	type result struct {
+		body SeekableBody
+		err  error
+	}
+	results := make(chan result, 100)
+	for i := 0; i < 100; i++ {
+		go func() {
+			body, err := budget.IngestSeekableResponse(context.Background(), strings.NewReader(`{"synthetic":"retained history"}`))
+			results <- result{body, err}
+		}()
+	}
+	bodies := make([]SeekableBody, 0, 100)
+	defer func() {
+		for _, body := range bodies {
+			_ = body.Close()
+		}
+	}()
+	for i := 0; i < 100; i++ {
+		result := <-results
+		if result.err != nil {
+			t.Error(result.err)
+			continue
+		}
+		bodies = append(bodies, result.body)
+	}
+	if active, _ := budget.Snapshot(); active != 100 {
+		t.Fatalf("only %d simultaneous bodies admitted", active)
+	}
+	entries, err := os.ReadDir(directory)
+	if err != nil || len(entries) != 0 {
+		t.Fatalf("private spool names survived: entries=%d err=%v", len(entries), err)
+	}
+	for _, body := range bodies {
+		if err := body.Close(); err != nil {
+			t.Error(err)
+		}
+	}
+	if active, reserved := budget.Snapshot(); active != 0 || reserved != 0 {
+		t.Fatalf("retained storage: active=%d reserved=%d", active, reserved)
+	}
+}
+
+func TestSeekableImagesHaveNoOpaqueValueCountCeiling(t *testing.T) {
+	budget, err := NewSeekableBodyBudget(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	readers := []io.Reader{strings.NewReader(`{"model":"probe","stream":true,"input":[{"role":"user","content":[`)}
+	for index := 0; index < 5000; index++ {
+		if index != 0 {
+			readers = append(readers, strings.NewReader(","))
+		}
+		readers = append(readers, strings.NewReader(`{"type":"input_image","image_url":"data:image/png;base64,`), io.LimitReader(repeatingA{}, (64<<10)+1), strings.NewReader(`"}`))
+	}
+	readers = append(readers, strings.NewReader(`]}]}`))
+	body, err := budget.IngestSeekableResponse(context.Background(), io.MultiReader(readers...))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer body.Close()
+	shadow, err := BuildSeekableJSONShadow(context.Background(), body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(shadow.Markers) != 5000 {
+		t.Fatalf("opaque images truncated: %d", len(shadow.Markers))
+	}
+	if len(shadow.JSON) > 1<<20 {
+		t.Fatalf("opaque image bytes retained in metadata: %d", len(shadow.JSON))
+	}
+	if err := body.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if active, reserved := budget.Snapshot(); active != 0 || reserved != 0 {
+		t.Fatalf("large images retained storage: %d/%d", active, reserved)
+	}
+}
