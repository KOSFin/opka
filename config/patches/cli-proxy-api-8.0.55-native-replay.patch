+//go:build linux || darwin
+
+package executor
+
+import (
+	"fmt"
+	"syscall"
+)
+
+func assertSeekableDiskFree(directory string, next int64) error {
+	var info syscall.Statfs_t
+	if err := syscall.Statfs(directory, &info); err != nil {
+		return fmt.Errorf("%w: cannot measure private spool storage", ErrSeekableDiskPressure)
+	}
+	const floor = uint64(2 << 30)
+	available := uint64(info.Bavail) * uint64(info.Bsize)
+	if next < 1 || available < floor || uint64(next) > available-floor {
+		return ErrSeekableDiskPressure
+	}
+	return nil
+}
