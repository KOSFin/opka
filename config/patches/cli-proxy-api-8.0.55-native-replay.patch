+package handlers
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gin-gonic/gin"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+const SeekableReplayHeader = "X-Orca-Native-Replay-V1"
+
+type seekableRequestKey struct{}
+type seekableResponseKey struct{}
+
+type SeekableResponseCapture struct {
+	mu   sync.Mutex
+	body coreexecutor.SeekableBody
+}
+
+func WithSeekableResponseCapture(ctx context.Context, capture *SeekableResponseCapture) context.Context {
+	return context.WithValue(ctx, seekableResponseKey{}, capture)
+}
+
+func seekableResponseCaptureFromContext(ctx context.Context) *SeekableResponseCapture {
+	capture, _ := ctx.Value(seekableResponseKey{}).(*SeekableResponseCapture)
+	return capture
+}
+
+func (c *SeekableResponseCapture) Set(body coreexecutor.SeekableBody) {
+	c.mu.Lock()
+	c.body = body
+	c.mu.Unlock()
+}
+
+func (c *SeekableResponseCapture) Take() coreexecutor.SeekableBody {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	body := c.body
+	c.body = nil
+	return body
+}
+
+func HasSeekableResponse(ctx context.Context) bool {
+	capture := seekableResponseCaptureFromContext(ctx)
+	if capture == nil {
+		return false
+	}
+	capture.mu.Lock()
+	defer capture.mu.Unlock()
+	return capture.body != nil
+}
+
+type SeekableRequest struct {
+	Body       coreexecutor.SeekableBody
+	Budget     *coreexecutor.SeekableBodyBudget
+	ShadowJSON []byte
+	Shadow     coreexecutor.SeekableJSONShadow
+	ModelStart int64
+	ModelEnd   int64
+}
+
+func WithSeekableRequest(ctx context.Context, request SeekableRequest) context.Context {
+	return context.WithValue(ctx, seekableRequestKey{}, request)
+}
+
+func seekableRequestFromContext(ctx context.Context) (SeekableRequest, bool) {
+	request, ok := ctx.Value(seekableRequestKey{}).(SeekableRequest)
+	return request, ok && request.Body != nil
+}
+
+var seekableBudgetOnce sync.Once
+var seekableBudget *coreexecutor.SeekableBodyBudget
+var seekableBudgetError error
+
+// ReadSeekableRequest admits a body only after the existing API-key middleware.
+// The authenticated local routing peer supplies bounded fields and a full-body
+// digest; the body stays private and is verified before any provider execution.
+func ReadSeekableRequest(c *gin.Context, compact bool) (SeekableRequest, error) {
+	if c == nil || c.Request == nil || c.Request.Header.Get(SeekableReplayHeader) != "1" {
+		return SeekableRequest{}, errors.New("seekable replay marker is missing")
+	}
+	if c.GetString("userApiKey") == "" {
+		return SeekableRequest{}, errors.New("seekable replay needs an authenticated local peer")
+	}
+	if encoding := c.Request.Header.Get("Content-Encoding"); encoding != "" && !strings.EqualFold(encoding, "identity") {
+		return SeekableRequest{}, errors.New("seekable replay does not support compressed ingress")
+	}
+	stream := c.Request.Header.Get("X-Orca-Native-Replay-Stream")
+	if stream != "true" && stream != "false" {
+		return SeekableRequest{}, errors.New("seekable replay stream mode is invalid")
+	}
+	if compact && stream != "false" {
+		return SeekableRequest{}, errors.New("compact replay cannot stream")
+	}
+	start, err := strconv.ParseInt(c.Request.Header.Get("X-Orca-Native-Replay-Model-Start"), 10, 64)
+	if err != nil || start < 0 {
+		return SeekableRequest{}, errors.New("seekable replay model offset is invalid")
+	}
+	end, err := strconv.ParseInt(c.Request.Header.Get("X-Orca-Native-Replay-Model-End"), 10, 64)
+	if err != nil || end <= start {
+		return SeekableRequest{}, errors.New("seekable replay model extent is invalid")
+	}
+	seekableBudgetOnce.Do(func() {
+		seekableBudget, seekableBudgetError = coreexecutor.NewSeekableBodyBudget(0)
+	})
+	if seekableBudgetError != nil {
+		return SeekableRequest{}, seekableBudgetError
+	}
+	body, err := seekableBudget.IngestSeekableBody(c.Request.Context(), c.Request.Body, c.Request.Header.Get("X-Orca-Native-Replay-SHA256"))
+	if err != nil {
+		return SeekableRequest{}, err
+	}
+	model, err := body.ReadJSONStringRange(start, end)
+	if err != nil || len(model) < 1 || len(model) > 300 || strings.ContainsAny(model, "\r\n") {
+		_ = body.Close()
+		return SeekableRequest{}, errors.New("seekable replay model range is invalid")
+	}
+	shadow, err := coreexecutor.BuildSeekableJSONShadow(c.Request.Context(), body)
+	if err != nil {
+		_ = body.Close()
+		return SeekableRequest{}, err
+	}
+	if ojson.GetBytesNoCopy(shadow.JSON, "model").String() != model ||
+		(ojson.GetBytesNoCopy(shadow.JSON, "stream").Type == ojson.True) != (stream == "true") {
+		_ = body.Close()
+		return SeekableRequest{}, errors.New("seekable replay routing metadata changed inside the body")
+	}
+	previous := ojson.GetBytesNoCopy(shadow.JSON, "previous_response_id")
+	if previous.Exists() && previous.Type != ojson.Null {
+		_ = body.Close()
+		return SeekableRequest{}, errors.New("seekable replay requires the complete local conversation history")
+	}
+	return SeekableRequest{Body: body, Budget: seekableBudget, ShadowJSON: shadow.JSON, Shadow: shadow, ModelStart: start, ModelEnd: end}, nil
+}
+
+func SeekableRequestError(c *gin.Context, err error) {
+	status := http.StatusUnprocessableEntity
+	if errors.Is(err, coreexecutor.ErrSeekableDiskPressure) {
+		status = http.StatusInsufficientStorage
+	}
+	c.JSON(status, ErrorResponse{Error: ErrorDetail{Message: err.Error(), Type: "invalid_request_error"}})
+}
