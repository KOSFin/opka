+package executor
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestSeekableBodyReplaysLargeOpaqueJSONWithoutResidentCopy(t *testing.T) {
+	budget, err := NewSeekableBodyBudget(512 << 20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const head = `{"model":"pool/native","input":[{"content":"`
+	const tail = `"}]}`
+	const largeBytes = 72 << 20
+	reader := func() io.Reader {
+		return io.MultiReader(strings.NewReader(head), io.LimitReader(repeatingA{}, largeBytes), strings.NewReader(tail))
+	}
+	originalDigest := sha256.New()
+	if _, err := io.Copy(originalDigest, reader()); err != nil {
+		t.Fatal(err)
+	}
+	body, err := budget.IngestSeekableBody(context.Background(), reader(), hex.EncodeToString(originalDigest.Sum(nil)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	private := body.(*privateSeekableBody)
+	dir := filepath.Dir(private.file.Name())
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("private directory remained while the body was open: %v", err)
+	}
+	start := int64(len(`{"model":`))
+	end := start + int64(len(`"pool/native"`))
+	if model, err := body.ReadJSONStringRange(start, end); err != nil || model != "pool/native" {
+		t.Fatalf("model=%q, err=%v", model, err)
+	}
+	want := sha256.New()
+	_, _ = io.WriteString(want, `{"model":"native","input":[{"content":"`)
+	_, _ = io.Copy(want, io.LimitReader(repeatingA{}, largeBytes))
+	_, _ = io.WriteString(want, tail)
+	for attempt := 0; attempt < 2; attempt++ {
+		got := sha256.New()
+		count, err := WriteSeekableModel(context.Background(), body, start, end, "native", got)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if count != int64(len(head)+largeBytes+len(tail)-len(`"pool/native"`)+len(`"native"`)) {
+			t.Fatalf("attempt %d length=%d", attempt, count)
+		}
+		if hex.EncodeToString(got.Sum(nil)) != hex.EncodeToString(want.Sum(nil)) {
+			t.Fatalf("attempt %d changed opaque history", attempt)
+		}
+	}
+	shadow, err := BuildSeekableJSONShadow(context.Background(), body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(shadow.Markers) != 1 || len(shadow.JSON) > 1<<20 {
+		t.Fatalf("shadow retained large content: markers=%d bytes=%d", len(shadow.Markers), len(shadow.JSON))
+	}
+	transformed := bytes.Replace(shadow.JSON, []byte(`"pool/native"`), []byte(`"native"`), 1)
+	rebuilt := sha256.New()
+	if _, err := WriteReconstitutedJSON(context.Background(), body, shadow, transformed, rebuilt); err != nil {
+		t.Fatal(err)
+	}
+	if hex.EncodeToString(rebuilt.Sum(nil)) != hex.EncodeToString(want.Sum(nil)) {
+		t.Fatal("reconstructed mutation lost opaque history")
+	}
+	if err := body.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(dir); !os.IsNotExist(err) {
+		t.Fatalf("private directory remained: %v", err)
+	}
+	if active, reserved := budget.Snapshot(); active != 0 || reserved != 0 {
+		t.Fatalf("budget active=%d reserved=%d", active, reserved)
+	}
+}
+
+func TestSeekableShadowRejectsInvalidOpaqueString(t *testing.T) {
+	for _, invalid := range []string{`\q`, `\u12xz`, string([]byte{0xc0, 0xaf}), string([]byte{0xed, 0xa0, 0x80}), "\n"} {
+		budget, err := NewSeekableBodyBudget(256 << 20)
+		if err != nil {
+			t.Fatal(err)
+		}
+		payload := []byte(`{"model":"native","input":[{"content":"` + strings.Repeat("a", 64<<10) + invalid + `"}]}`)
+		digest := sha256.Sum256(payload)
+		body, err := budget.IngestSeekableBody(context.Background(), bytes.NewReader(payload), hex.EncodeToString(digest[:]))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := BuildSeekableJSONShadow(context.Background(), body); err == nil {
+			t.Fatalf("invalid opaque string was accepted: %q", invalid)
+		}
+		if err := body.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestSeekableBodyCancelledAdmissionReleasesBudget(t *testing.T) {
+	budget, err := NewSeekableBodyBudget(256 << 20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	reader := &cancelAfterFirstRead{cancel: cancel}
+	if _, err := budget.IngestSeekableResponse(ctx, reader); err == nil {
+		t.Fatal("cancelled admission completed")
+	}
+	if active, reserved := budget.Snapshot(); active != 0 || reserved != 0 {
+		t.Fatalf("cancelled body retained capacity: active=%d reserved=%d", active, reserved)
+	}
+}
+
+func TestSeekableSmallAdmissionUsesReservedHeadroom(t *testing.T) {
+	budget, err := NewSeekableBodyBudget(512 << 20)
+	if err != nil {
+		t.Fatal(err)
+	}
+	budget.mu.Lock()
+	budget.reserved = 448 << 20
+	budget.active = 1
+	budget.mu.Unlock()
+	payload := []byte(`{"model":"small","input":[]}`)
+	digest := sha256.Sum256(payload)
+	body, err := budget.IngestSeekableBody(context.Background(), bytes.NewReader(payload), hex.EncodeToString(digest[:]))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if active, reserved := budget.Snapshot(); active != 2 || reserved != 448<<20+2*int64(len(payload)) {
+		t.Fatalf("small work could not use reserved headroom: active=%d reserved=%d", active, reserved)
+	}
+	if err := body.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if active, reserved := budget.Snapshot(); active != 1 || reserved != 448<<20 {
+		t.Fatalf("small work did not release its headroom: active=%d reserved=%d", active, reserved)
+	}
+}
+
+type cancelAfterFirstRead struct {
+	cancel context.CancelFunc
+	read   bool
+}
+
+func (r *cancelAfterFirstRead) Read(chunk []byte) (int, error) {
+	if r.read {
+		return 0, io.EOF
+	}
+	r.read = true
+	r.cancel()
+	chunk[0] = 'A'
+	return 1, nil
+}
+
+type repeatingA struct{}
+
+func (repeatingA) Read(chunk []byte) (int, error) {
+	for i := range chunk {
+		chunk[i] = 'A'
+	}
+	return len(chunk), nil
+}
+
+func TestSeekableProviderTerminalProofRequiresExplicitCurrentCompletion(t *testing.T) {
+	request, proof := WithSeekableProviderTerminalProof(context.Background())
+	if proof.Complete() {
+		t.Fatal("local response cannot prove provider termination")
+	}
+	parent := InheritSeekableProviderTerminalProof(context.Background(), request)
+	first := BeginSeekableProviderAttempt(parent)
+	cancelled, cancel := context.WithCancel(first)
+	cancel()
+	MarkSeekableProviderTerminalProof(cancelled)
+	if proof.Complete() {
+		t.Fatal("cancelled provider attempt cannot become terminal proof")
+	}
+	MarkSeekableProviderTerminalProof(first)
+	if !proof.Complete() {
+		t.Fatal("completed provider attempt did not propagate to its handler")
+	}
+	second := BeginSeekableProviderAttempt(parent)
+	if proof.Complete() {
+		t.Fatal("an earlier attempt cannot prove a new attempt is complete")
+	}
+	MarkSeekableProviderTerminalProof(first)
+	if proof.Complete() {
+		t.Fatal("a late earlier attempt cannot prove the current attempt is complete")
+	}
+	MarkSeekableProviderTerminalProof(second)
+	if !proof.Complete() {
+		t.Fatal("current attempt completion was not recorded")
+	}
+}
