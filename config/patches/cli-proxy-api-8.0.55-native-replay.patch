+func TestDecodeSeekableCompactResponseBody(t *testing.T) {
+	plain := []byte(`{"output":[{"type":"compaction","encrypted_content":"` + string(bytes.Repeat([]byte("A"), 1<<20)) + `"},{"type":"message","content":"retained"}]}`)
+	for _, tt := range []struct {
+		name      string
+		encodings []string
+		header    http.Header
+	}{
+		{name: "plain"},
+		{name: "gzip", encodings: []string{"gzip"}, header: http.Header{"Content-Encoding": {"gzip"}}},
+		{name: "gzip-sniff", encodings: []string{"gzip"}},
+		{name: "deflate", encodings: []string{"deflate"}, header: http.Header{"Content-Encoding": {"deflate"}}},
+		{name: "brotli", encodings: []string{"br"}, header: http.Header{"Content-Encoding": {"br"}}},
+		{name: "zstd", encodings: []string{"zstd"}, header: http.Header{"Content-Encoding": {"zstd"}}},
+		{name: "zstd-sniff", encodings: []string{"zstd"}},
+		{name: "stacked", encodings: []string{"gzip", "br", "zstd"}, header: http.Header{"Content-Encoding": {"gzip, br, zstd"}}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			wire := plain
+			for _, encoding := range tt.encodings {
+				wire = encodeResponseDecodeTestBody(t, encoding, wire)
+			}
+			body := &responseDecodeTestBody{Reader: bytes.NewReader(wire)}
+			decoded, errDecode := DecodeSeekableCompactResponseBody(body, tt.header)
+			if errDecode != nil {
+				t.Fatal(errDecode)
+			}
+			got, errRead := io.ReadAll(decoded)
+			errClose := decoded.Close()
+			if errRead != nil || errClose != nil || !bytes.Equal(got, plain) || body.closeCount != 1 {
+				t.Fatalf("compact decode mismatch: read=%v close=%v length=%d closed=%d", errRead, errClose, len(got), body.closeCount)
+			}
+		})
+	}
+}
+
+func TestDecodeSeekableCompactResponseBodyRejectsEncodingBomb(t *testing.T) {
+	body := &responseDecodeTestBody{Reader: bytes.NewReader([]byte("invalid"))}
+	if _, err := DecodeSeekableCompactResponseBody(body, http.Header{"Content-Encoding": {"gzip, br, zstd, gzip, br"}}); err == nil {
+		t.Fatal("too many layers accepted")
+	}
+	if body.closeCount != 1 {
+		t.Fatalf("rejected response closed source %d times", body.closeCount)
+	}
+	malformed := &responseDecodeTestBody{Reader: bytes.NewReader([]byte("invalid"))}
+	decoded, err := DecodeSeekableCompactResponseBody(malformed, http.Header{"Content-Encoding": {"zstd"}})
+	if err == nil {
+		_, err = io.Copy(io.Discard, decoded)
+		_ = decoded.Close()
+	}
+	if err == nil || malformed.closeCount != 1 {
+		t.Fatalf("malformed compressed compact accepted or leaked: err=%v closed=%d", err, malformed.closeCount)
+	}
+	sniffed := &responseDecodeTestBody{Reader: bytes.NewReader([]byte{0x28, 0xb5, 0x2f, 0xfd, 0x00})}
+	decoded, err = DecodeSeekableCompactResponseBody(sniffed, nil)
+	if err == nil {
+		_, err = io.Copy(io.Discard, decoded)
+		_ = decoded.Close()
+	}
+	if err == nil || sniffed.closeCount != 1 {
+		t.Fatalf("malformed sniffed compact accepted or leaked: err=%v closed=%d", err, sniffed.closeCount)
+	}
+}
+
+func TestDecodeSeekableCompactResponseBodyRejectsLargeZstdWindow(t *testing.T) {
+	var wire bytes.Buffer
+	encoder, err := zstd.NewWriter(&wire, zstd.WithWindowSize(64<<20), zstd.WithEncoderConcurrency(1))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = encoder.Write(bytes.Repeat([]byte("W"), 64<<20)); err != nil {
+		t.Fatal(err)
+	}
+	if err = encoder.Close(); err != nil {
+		t.Fatal(err)
+	}
+	for _, header := range []http.Header{{"Content-Encoding": {"zstd"}}, nil} {
+		body := &responseDecodeTestBody{Reader: bytes.NewReader(wire.Bytes())}
+		decoded, errDecode := DecodeSeekableCompactResponseBody(body, header)
+		if errDecode == nil {
+			_, errDecode = io.Copy(io.Discard, decoded)
+			_ = decoded.Close()
+		}
+		if errDecode == nil || body.closeCount != 1 {
+			t.Fatalf("oversized zstd window accepted or leaked: err=%v closed=%d", errDecode, body.closeCount)
+		}
+	}
+}
