+package openai
+
+import (
+	"bytes"
+	"errors"
+	"io"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// These wrappers retain the ordinary Responses route, auth manager and hooks.
+// The seekable body remains separate from the bounded routing shadow.
+func (h *OpenAIResponsesAPIHandler) responsesSeekable(c *gin.Context) {
+	h.withSeekableBody(c, false, h.Responses)
+}
+
+func (h *OpenAIResponsesAPIHandler) compactSeekable(c *gin.Context) {
+	h.withSeekableBody(c, true, h.Compact)
+}
+
+func (h *OpenAIResponsesAPIHandler) withSeekableBody(c *gin.Context, compact bool, next func(*gin.Context)) {
+	if !h.SeekableReplayInterceptorsDisabled() {
+		handlers.SeekableRequestError(c, errors.New("seekable replay does not support active interceptors"))
+		return
+	}
+	request, err := handlers.ReadSeekableRequest(c, compact)
+	if err != nil {
+		handlers.SeekableRequestError(c, err)
+		return
+	}
+	defer request.Body.Close()
+	capture := &handlers.SeekableResponseCapture{}
+	c.Request.Header.Del(handlers.SeekableReplayHeader)
+	c.Request.Header.Del("Content-Encoding")
+	ctx := handlers.WithSeekableRequest(c.Request.Context(), request)
+	ctx = handlers.WithSeekableResponseCapture(ctx, capture)
+	ctx, proof := cliproxyexecutor.WithSeekableProviderTerminalProof(ctx)
+	c.Request = c.Request.WithContext(ctx)
+	c.Request.Body = io.NopCloser(bytes.NewReader(request.ShadowJSON))
+	c.Request.ContentLength = int64(len(request.ShadowJSON))
+	c.Header("Trailer", "X-Orca-Provider-Terminal-V1")
+	next(c)
+	if proof.Complete() {
+		c.Writer.Header().Set("X-Orca-Provider-Terminal-V1", "1")
+	}
+	if response := capture.Take(); response != nil {
+		defer response.Close()
+		c.Writer.Header().Del("Content-Length")
+		stream, openErr := response.Open()
+		if openErr != nil {
+			handlers.SeekableRequestError(c, openErr)
+			return
+		}
+		defer stream.Close()
+		if _, copyErr := io.Copy(c.Writer, stream); copyErr != nil {
+			c.Header("Connection", "close")
+		}
+	}
+}
