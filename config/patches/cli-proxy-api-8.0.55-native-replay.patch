+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+)
+
+const (
+	seekableInlineStringBytes = 64 << 10
+	seekableShadowBytes       = 8 << 20
+)
+
+type SeekableJSONMarker struct {
+	Literal []byte
+	Start   int64
+	End     int64
+}
+
+type SeekableJSONShadow struct {
+	JSON    []byte
+	Markers []SeekableJSONMarker
+	Seed    string
+}
+
+func (s SeekableJSONShadow) ReconstitutedLength(transformed []byte) (int64, error) {
+	length := int64(len(transformed))
+	for _, marker := range s.Markers {
+		if bytes.Count(transformed, marker.Literal) != 1 {
+			return 0, errors.New("transformed seekable JSON changed an opaque value")
+		}
+		length += marker.End - marker.Start - int64(len(marker.Literal))
+	}
+	return length, nil
+}
+
+// BuildSeekableJSONShadow keeps JSON structure and small fields in memory while
+// leaving large string values on the private body. The caller must prove that
+// transformations do not depend on any omitted string before provider traffic.
+func BuildSeekableJSONShadow(ctx context.Context, body SeekableBody) (SeekableJSONShadow, error) {
+	if body == nil {
+		return SeekableJSONShadow{}, errors.New("seekable source is missing")
+	}
+	source, err := body.Open()
+	if err != nil {
+		return SeekableJSONShadow{}, err
+	}
+	defer source.Close()
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		return SeekableJSONShadow{}, err
+	}
+	seed := hex.EncodeToString(nonce[:])
+	reader := bufio.NewReaderSize(source, seekableChunkBytes)
+	var shadow bytes.Buffer
+	var pending bytes.Buffer
+	markers := make([]SeekableJSONMarker, 0)
+	var offset, stringStart int64
+	inString, escaped, omitted := false, false, false
+	unicodeDigits, utf8Remaining := 0, 0
+	var utf8NextMin, utf8NextMax byte
+	for {
+		if err := ctx.Err(); err != nil {
+			return SeekableJSONShadow{}, err
+		}
+		value, readErr := reader.ReadByte()
+		if readErr == io.EOF {
+			break
+		}
+		if readErr != nil {
+			return SeekableJSONShadow{}, readErr
+		}
+		if !inString {
+			if value == '"' {
+				inString, escaped, omitted = true, false, false
+				unicodeDigits, utf8Remaining = 0, 0
+				stringStart = offset
+				pending.Reset()
+				_ = pending.WriteByte(value)
+			} else {
+				_ = shadow.WriteByte(value)
+			}
+		} else {
+			if !omitted {
+				_ = pending.WriteByte(value)
+				if pending.Len() > seekableInlineStringBytes {
+					omitted = true
+					pending.Reset()
+				}
+			}
+			closing := false
+			switch {
+			case unicodeDigits > 0:
+				if !((value >= '0' && value <= '9') || (value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F')) {
+					return SeekableJSONShadow{}, errors.New("seekable JSON has an invalid unicode escape")
+				}
+				unicodeDigits--
+			case escaped:
+				escaped = false
+				if value == 'u' {
+					unicodeDigits = 4
+				} else if value != '"' && value != '\\' && value != '/' && value != 'b' && value != 'f' && value != 'n' && value != 'r' && value != 't' {
+					return SeekableJSONShadow{}, errors.New("seekable JSON has an invalid string escape")
+				}
+			case utf8Remaining > 0:
+				if value < utf8NextMin || value > utf8NextMax {
+					return SeekableJSONShadow{}, errors.New("seekable JSON has invalid UTF-8")
+				}
+				utf8Remaining--
+				utf8NextMin, utf8NextMax = 0x80, 0xbf
+			case value == '\\':
+				escaped = true
+			case value == '"':
+				closing = true
+			case value < 0x20:
+				return SeekableJSONShadow{}, errors.New("seekable JSON has an unescaped control byte")
+			case value >= 0x80:
+				switch {
+				case value >= 0xc2 && value <= 0xdf:
+					utf8Remaining, utf8NextMin, utf8NextMax = 1, 0x80, 0xbf
+				case value == 0xe0:
+					utf8Remaining, utf8NextMin, utf8NextMax = 2, 0xa0, 0xbf
+				case value >= 0xe1 && value <= 0xec, value >= 0xee && value <= 0xef:
+					utf8Remaining, utf8NextMin, utf8NextMax = 2, 0x80, 0xbf
+				case value == 0xed:
+					utf8Remaining, utf8NextMin, utf8NextMax = 2, 0x80, 0x9f
+				case value == 0xf0:
+					utf8Remaining, utf8NextMin, utf8NextMax = 3, 0x90, 0xbf
+				case value >= 0xf1 && value <= 0xf3:
+					utf8Remaining, utf8NextMin, utf8NextMax = 3, 0x80, 0xbf
+				case value == 0xf4:
+					utf8Remaining, utf8NextMin, utf8NextMax = 3, 0x80, 0x8f
+				default:
+					return SeekableJSONShadow{}, errors.New("seekable JSON has invalid UTF-8")
+				}
+			}
+			if closing {
+				inString = false
+				if omitted {
+					literal := []byte(fmt.Sprintf(`"__orca_replay_%s_%d__"`, seed, len(markers)))
+					_, _ = shadow.Write(literal)
+					markers = append(markers, SeekableJSONMarker{Literal: literal, Start: stringStart, End: offset + 1})
+				} else {
+					_, _ = shadow.Write(pending.Bytes())
+				}
+			}
+		}
+		offset++
+		if shadow.Len() > seekableShadowBytes {
+			return SeekableJSONShadow{}, errors.New("seekable JSON structural state exceeds its budget")
+		}
+	}
+	if inString || escaped || unicodeDigits != 0 || utf8Remaining != 0 || offset != body.Size() || !json.Valid(shadow.Bytes()) {
+		return SeekableJSONShadow{}, errors.New("seekable JSON is incomplete or invalid")
+	}
+	return SeekableJSONShadow{JSON: bytes.Clone(shadow.Bytes()), Markers: markers, Seed: seed}, nil
+}
+
+// WriteReconstitutedJSON replaces each unique marker with its exact raw JSON
+// string from the source body; missing or duplicated markers fail closed.
+func WriteReconstitutedJSON(ctx context.Context, source SeekableBody, shadow SeekableJSONShadow, transformed []byte, output io.Writer) (int64, error) {
+	if !json.Valid(transformed) {
+		return 0, errors.New("transformed seekable JSON is invalid")
+	}
+	var total int64
+	remaining := transformed
+	seen := make(map[string]bool, len(shadow.Markers))
+	markers := make(map[string]SeekableJSONMarker, len(shadow.Markers))
+	for _, marker := range shadow.Markers {
+		markers[string(marker.Literal)] = marker
+	}
+	prefix := []byte(`"__orca_replay_` + shadow.Seed + `_`)
+	for len(remaining) > 0 {
+		if err := ctx.Err(); err != nil {
+			return total, err
+		}
+		firstIndex := bytes.Index(remaining, prefix)
+		if firstIndex < 0 {
+			written, err := output.Write(remaining)
+			total += int64(written)
+			if err != nil {
+				return total, err
+			}
+			if written != len(remaining) {
+				return total, io.ErrShortWrite
+			}
+			break
+		}
+		written, err := output.Write(remaining[:firstIndex])
+		total += int64(written)
+		if err != nil {
+			return total, err
+		}
+		if written != firstIndex {
+			return total, io.ErrShortWrite
+		}
+		closing := bytes.IndexByte(remaining[firstIndex+len(prefix):], '"')
+		if closing < 0 {
+			return total, errors.New("transformed seekable JSON has an incomplete marker")
+		}
+		literal := string(remaining[firstIndex : firstIndex+len(prefix)+closing+1])
+		marker, ok := markers[literal]
+		if !ok {
+			return total, errors.New("transformed seekable JSON changed an opaque marker")
+		}
+		key := string(marker.Literal)
+		if seen[key] {
+			return total, errors.New("transformed seekable JSON duplicated an opaque value")
+		}
+		seen[key] = true
+		copied, err := source.CopySpan(ctx, output, marker.Start, marker.End)
+		total += copied
+		if err != nil {
+			return total, err
+		}
+		remaining = remaining[firstIndex+len(marker.Literal):]
+	}
+	if len(seen) != len(shadow.Markers) {
+		return total, errors.New("transformed seekable JSON discarded an opaque value")
+	}
+	return total, nil
+}
