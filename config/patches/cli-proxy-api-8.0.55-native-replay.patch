+func TestSeekableCompactRawProviderEOFBeforeTerminalProof(t *testing.T) {
+	for _, status := range []int{http.StatusOK, http.StatusTooManyRequests} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			const content = `{"output":[{"type":"compaction","encrypted_content":"synthetic"}]}`
+			release := make(chan struct{})
+			var releaseOnce sync.Once
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(status)
+				_, _ = io.WriteString(w, content)
+				w.(http.Flusher).Flush()
+				<-release
+			}))
+			defer func() {
+				releaseOnce.Do(func() { close(release) })
+				server.Close()
+			}()
+			requestCtx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			proofCtx, proof := cliproxyexecutor.WithSeekableProviderTerminalProof(requestCtx)
+			attempt := cliproxyexecutor.BeginSeekableProviderAttempt(proofCtx)
+			request, err := http.NewRequestWithContext(requestCtx, http.MethodPost, server.URL, bytes.NewReader([]byte(`{"model":"synthetic"}`)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			var raw io.ReadCloser
+			response, err := doCodexRequestWithDecoder(server.Client(), request, []byte(`{"model":"synthetic"}`), func(*http.Request) {}, func(received *http.Response) {
+				raw = received.Body
+			}, func(received *http.Response) error {
+				received.Body = io.NopCloser(io.LimitReader(received.Body, int64(len(content))))
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer response.Body.Close()
+			defer raw.Close()
+			body, err := io.ReadAll(response.Body)
+			if err != nil || string(body) != content || proof.Complete() {
+				t.Fatalf("decoded window or initial proof invalid: read=%v complete=%v", err, proof.Complete())
+			}
+			terminal := make(chan error, 1)
+			go func() { terminal <- requireCodexRawProviderEOF(raw, cancel) }()
+			select {
+			case err := <-terminal:
+				t.Fatalf("raw provider reported EOF while its owner was held: %v", err)
+			case <-time.After(50 * time.Millisecond):
+			}
+			if proof.Complete() {
+				t.Fatal("decoded JSON alone certified provider terminal state")
+			}
+			releaseOnce.Do(func() { close(release) })
+			select {
+			case err := <-terminal:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(2 * time.Second):
+				t.Fatal("raw provider EOF did not settle")
+			}
+			cliproxyexecutor.MarkSeekableProviderTerminalProof(attempt)
+			if !proof.Complete() {
+				t.Fatal("proven provider terminal state was not recorded")
+			}
+		})
+	}
+}
